<h1>Search Flights</h1>

<%= form_with url: flights_path, method: :get do |form| %>
  <div>
    <%= form.label :departure_code, "Departure Airport" %>
    <%= form.select(:departure_code, @airport_options, prompt: "---Please Select---") %>
  </div>
  <div>
    <%= form.label :arrival_code, "Arrival Airport" %>
    <%= form.select(:arrival_code, @airport_options, prompt: "---Please Select---") %>
  </div>
  <div>
    <%= form.label :date %>
    <%= form.select(:date, @flight_date_options, prompt: "---Please Select---")%>
  </div>
  <div>
    <%= form.label :num_tickets %>
    <%= form.select(:num_tickets, (1..4), prompt: "---Please Select---", required: true) %>
  </div>
  <%= form.submit "Search Flights", name: nil %>
<% end %>

<% if @results %>
  <h3>Search Results</h3>
  
  <% if @results.empty? %>
    <p>No available flights</p>

  <% else %>
    <%= form_with url: new_booking_path, method: :get do |form| %>
      <%= form.hidden_field :num_tickets, value: params[:num_tickets] %>
      <% @results.each do |flight| %>
        <div>
          <%= form.radio_button :flight, flight.id %>
          <%= form.label "flight_#{flight.id}" do %>
            <%= flight.start_datetime.strftime("%Y-%m-%d %H:%m") %>
            <%= flight.departure_airport.airport_code %> to <%= flight.arrival_airport.airport_code %>
          <% end %>
        </div>
      <% end %>
      <%= form.submit "Book Flight"%>
    <% end %>
  <% end %>
<% end %>
<h1>Booking Details</h1>

<%= form_with model: @booking do |form| %>
  <div>
    <h2>Flight Information</h2>
    <p>Flight ID: <%= @flight.id %></p>
    <p>Date: <%= @flight.start_datetime.strftime("%Y %b %d") %></p>
    <p>Departure Time: <%= @flight.start_datetime.strftime("%H:%m") %></p>
    <p>Departure Airport: <%= @flight.departure_airport.airport_code %></p>
    <p>Arrival Airport: <%= @flight.arrival_airport.airport_code %></p>
    <p>Number of Passengers: <%= @num_tickets %></p>

    <%= form.hidden_field :flight_id, value: @flight.id %>
    <%= form.hidden_field :num_tickets, value: @num_tickets %>
  </div>

  <div>
    <h2>Passenger Information</h2>
    <% if @booking.errors.any? %>
    <div id="error_explanation">
      <h2>Error(s) prohibited this booking from being created:</h2>

      <ul>
        <% @booking.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

    <% @booking.passengers.each_with_index do |passenger, index| %>
      <h3>Passenger <%= index + 1 %></h3>
      <%= form.fields_for :passengers, passenger do |sub_form| %>  
        <div>
          <%= sub_form.label :name %>
          <%= sub_form.text_field :name %>
        </div>
        <div>
          <%= sub_form.label :email %>
          <%= sub_form.email_field :email %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= form.submit %>
<% end %>